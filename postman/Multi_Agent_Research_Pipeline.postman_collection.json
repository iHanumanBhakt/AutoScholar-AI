            "body": {
              "mode": "raw",
              "raw": "{\n  \"sources\": [\n    {\n      \"title\": \"Advancements in Multi-Agent Collaborative Frameworks\",\n      \"url\": \"https://arxiv.org/abs/2401.00001\"\n    }\n  ]\n}"
