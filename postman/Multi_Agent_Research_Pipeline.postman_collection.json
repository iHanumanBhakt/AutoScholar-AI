    {
      "name": "04. End-to-End Research Sessions",
      "item": [
        {
          "name": "1. Create Research Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.session && res.data.session._id) {",
                  "    pm.collectionVariables.set('sessionId', res.data.session._id);",
                  "    console.log('Session ID set to:', res.data.session._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Survey on Autonomous Multi-Agent Research Assistants\",\n  \"researchQuestion\": \"What are the main architectural paradigms for agentic information synthesis?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/research/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "research", "sessions"]
            }
          }
        },
        {
          "name": "2. Get All Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/research/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "research", "sessions"]
            }
          }
        },
        {
          "name": "3. Get Session By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/research/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "research", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "4. Execute Full Pipeline for Session",
          "request": {
            "method": "POST",
            "header": [
