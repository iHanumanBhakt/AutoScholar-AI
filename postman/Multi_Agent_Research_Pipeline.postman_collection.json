    {
      "name": "03. Multi-Agent Pipeline Stages (Fig. 4.1)",
      "item": [
        {
          "name": "Stage 1: Research Planner Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"researchQuestion\": \"How do multi-agent architectures mitigate hallucinations in scientific literature extraction?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agents/plan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agents", "plan"]
            }
          }
        },
        {
          "name": "Stage 2: Information Retrieval Agent",
          "request": {
            "method": "POST",
            "header": [
